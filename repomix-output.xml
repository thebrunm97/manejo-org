                            <button type="button" onClick={() => setIsAddDialogOpen(false)} className="p-1 hover:bg-gray-100 rounded-full text-gray-400"><X size={20} /></button>
                        </div>

                        <p className="text-sm text-gray-600 mb-4 leading-relaxed">
