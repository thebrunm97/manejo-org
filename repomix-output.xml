    const { data, error } = await supabase
        .from('lotes_rastreabilidade')
        .select('*')
        .eq('caderno_campo_id', cadernoId)
        .maybeSingle();

    if (error) {
        console.error('Error checking for existing lot:', error);
        return null;
    }

    return data as LoteRastreabilidade;
