            {/* Specific Colheita Content */}
            <ColheitaTab
                draft={formData}
                updateDraft={updateForm}
                errors={errors}
                isEditMode={isEditMode}
            />

            {/* Custo da Operação (Integração Financeira Híbrida) */}
            <div className="bg-emerald-50 border border-emerald-100 rounded-xl p-4 sm:p-5">
                <ValorTotalInput
