                        </p>

                        <div className="flex items-start gap-3 p-3 bg-blue-50 border border-blue-100 rounded-xl mb-4">
                            <Info size={18} className="text-blue-500 shrink-0 mt-0.5" />
                            <p className="text-xs text-blue-700 font-medium">
