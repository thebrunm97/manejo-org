                {subvalue && (
                    <div className="text-[10px] font-black text-agro-floresta/40 mt-2 uppercase tracking-widest font-sans truncate w-full" title={String(subvalue)}>
                        {subvalue}
                    </div>
                )}
            </div>
        </div>
    );
};

// Mobile Log Card Component
