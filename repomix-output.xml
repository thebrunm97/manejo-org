<file path=".github/workflows/e2e-tests.yml">
name: E2E Tests

on:
  push:
    branches: [main, develop]
  pull_request:
    branches: [main, develop]

jobs:
  test:
    runs-on: ubuntu-latest
    timeout-minutes: 10
    
    defaults:
      run:
        working-directory: pmo-frontend

    steps:
      - name: Checkout código
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '20'
          cache: 'npm'
          cache-dependency-path: pmo-frontend/package-lock.json

      - name: Install dependencies
        run: npm ci

      - name: Install Playwright
        run: npx playwright install --with-deps chromium

      - name: Create .env.test from secrets
        run: |
          echo "VITE_SUPABASE_URL=${{ secrets.SUPABASE_URL }}" >> .env.test
          echo "VITE_SUPABASE_ANON_KEY=${{ secrets.VITE_SUPABASE_ANON_KEY }}" >> .env.test
          echo "E2E_TEST_USER_EMAIL=${{ secrets.E2E_TEST_USER_EMAIL }}" >> .env.test
          echo "E2E_TEST_USER_PASSWORD=${{ secrets.E2E_TEST_USER_PASSWORD }}" >> .env.test

      - name: Run E2E tests
        run: npm run test:e2e

      - name: Upload Playwright report
        if: failure()
        uses: actions/upload-artifact@v4
        with:
          name: playwright-report
          path: pmo-frontend/playwright-report/
          retention-days: 7

      - name: Upload test screenshots
        if: failure()
        uses: actions/upload-artifact@v4
        with:
          name: test-screenshots
          path: pmo-frontend/test-results/
          retention-days: 7
</file>

<file path="docker-compose.benchmark.yml">
services:
  redis:
    image: redis:alpine
    container_name: benchmark-redis
    networks:
      - benchmark-net

  bot-go:
    container_name: bot-go-benchmark
    build:
      context: ./pmo-bot-go
      dockerfile: Dockerfile
    restart: on-failure
    ports:
      - "8081:8080"
    env_file:
      - ./pmo-bot-go/.env
    environment:
      - PORT=8080
      - WPPCONNECT_URL=http://benchmark-runner:3333
      - GIN_MODE=release
      - MOCK_WHATSAPP=true
      - WPPCONNECT_TOKEN=benchmark_secret
      - REDIS_URL=redis://redis:6379
    depends_on:
      - redis
    networks:
      - benchmark-net

  benchmark-runner:
    container_name: benchmark-runner
    build:
      context: .
      dockerfile: Dockerfile.benchmark
    environment:
      - GO_BOT_URL=http://bot-go:8080
    ports:
      - "3333:3333"
    networks:
      - benchmark-net

networks:
  benchmark-net:
    driver: bridge
</file>

