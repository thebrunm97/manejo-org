	var resp map[string]interface{}
	json.Unmarshal(w.Body.Bytes(), &resp)
	jobID, ok := resp["job_id"].(string)
	if !ok || jobID == "" {
		t.Fatal("Response missing job_id")
	}
	t.Logf("✅ Job Created: %s", jobID)

	// 4. Polling Job Status
