import { useState, useEffect, useCallback, useRef } from "react";
import { useAuth } from "../../context/AuthContext";
import {
  dashboardService,
  HarvestSummary,
} from "../../services/dashboardService";
import { getCurrentWeather, WeatherData } from "../../services/weatherService";
import { fetchAllPmos } from "../../services/pmoService";
import { supabase } from "../../supabaseClient";

// Tipos do Estado do Dashboard
export interface DashboardData {
  weather: WeatherData | null;
  harvestStats: HarvestSummary;
  lastActivity: Date | null;
  recentActivities: any[];
  pmoId: string | null;
  pmoName: string | null;
  pmoVersion: number | null;
  userProfile: { telefone?: string } | null;
  whatsappStatus: {
    status: string;
    last_heartbeat: string | null;
    details: any;
  } | null;
}

export function useDashboardLogic() {
  const { user, currentPropriedade, profile } = useAuth();
  const hasFetchedDashboardRef = useRef<string | null>(null);

  // Estado Combinado
  const [data, setData] = useState<DashboardData>({
    weather: null,
    harvestStats: {},
    lastActivity: null,
    recentActivities: [],
    pmoId: null,
    pmoName: null,
    pmoVersion: null,
    userProfile: null,
    whatsappStatus: null,
  });

  const [isLoading, setIsLoading] = useState(true);
  const [dataError, setDataError] = useState<string | null>(null);

  const refreshDashboard = useCallback(async () => {
    if (!user?.id) return;

    setIsLoading(true);
    setDataError(null);

    try {
      const userTelefone = profile?.telefone;
      
      let activePmoId: string | null = profile?.pmo_ativo_id || null;
      let pmoName: string | null = null;
      let pmoVersion: number = 0;
      let harvestStats: HarvestSummary = {};
      let lastActivity: Date | null = null;
      let recentActivities: any[] = [];

      // 1. Carregar PMOs da propriedade para definir o PMO ativo REAL da fazenda selecionada
      if (currentPropriedade?.id) {
        const pmosRes = await fetchAllPmos(currentPropriedade.id);
        if (pmosRes.success && pmosRes.data && pmosRes.data.length > 0) {
          const emAndamento = pmosRes.data.find(p => (p as any).status === 'Em andamento' || (p as any).status === 'em_andamento') || pmosRes.data[0];
          activePmoId = emAndamento.id;
          pmoName = emAndamento.nome_identificador;
          pmoVersion = Number(emAndamento.version) || 1;
        } else {
          activePmoId = null; // sem PMO na propriedade atual
        }
      }

      // Buscar as estatísticas com o PMO / Propriedade correto
      if (activePmoId || currentPropriedade?.id) {
        const [recentRes, harvestRes, lastActRes] = await Promise.all([
          dashboardService.fetchRecentActivities(null, 5, currentPropriedade?.id),
          dashboardService.fetchHarvestSummary(null, currentPropriedade?.id),
          dashboardService.fetchLastActivity(null, currentPropriedade?.id)
        ]);

        recentActivities = recentRes;
        harvestStats = harvestRes;
        lastActivity = lastActRes;
      }

      // 2. Clima
      if (activePmoId) {
        const loadWeatherAsync = async (id: string) => {
          try {
            const weather = await getCurrentWeather(id);
            setData((prev) => ({ ...prev, weather }));
          } catch (e) {
            console.warn("DashboardLogic: Weather fetch failed", e);
          }
        };
        loadWeatherAsync(activePmoId);
      }

      // 3. Update State
      setData((prev) => ({
        ...prev,
        harvestStats,
        lastActivity,
        recentActivities,
        pmoId: activePmoId,
        pmoName: pmoName || currentPropriedade?.nome || "Minha Propriedade",
        pmoVersion: pmoVersion,
        userProfile: { telefone: userTelefone },
      }));
    } catch (err: any) {
      console.error("Erro no Dashboard:", err);
      setDataError(err.message || "Falha ao carregar dashboard.");
    } finally {
      setIsLoading(false);
    }
  }, [user?.id, profile, currentPropriedade]);

  // Status do WhatsApp em Tempo Real
  useEffect(() => {
    if (!user?.id) return;

    const fetchBotStatus = async () => {
      const { data: botStatus } = await supabase
        .from('bot_status')
        .select('*')
        .eq('session_name', import.meta.env.VITE_BOT_SESSION_NAME || 'manejo-org')
        .maybeSingle();

      
      if (botStatus) {
        setData(prev => ({ ...prev, whatsappStatus: botStatus }));
      }
    };

    fetchBotStatus();

    const channel = supabase
      .channel('bot-status-changes')
      .on(
        'postgres_changes',
        {
          event: '*',
          schema: 'public',
          table: 'bot_status',
          filter: `session_name=eq.${import.meta.env.VITE_BOT_SESSION_NAME || 'manejo-org'}`,
        },

        (payload) => {
          setData(prev => ({ ...prev, whatsappStatus: payload.new as any }));
        }
      )
      .subscribe();

    return () => {
      supabase.removeChannel(channel);
    };
  }, [user?.id]);

  useEffect(() => {
    const targetId = currentPropriedade?.id || profile?.pmo_ativo_id || "NONE";
    if (hasFetchedDashboardRef.current !== String(targetId) && user?.id) {
      hasFetchedDashboardRef.current = String(targetId);
      refreshDashboard();
    }
  }, [user?.id, profile?.pmo_ativo_id, currentPropriedade?.id, refreshDashboard]);

  return {
    ...data,
    isLoading,
    dataError,
    refreshDashboard,
  };
}
</file>

<file path="pmo-frontend/src/index.css">
@import url('https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,700&family=Inter:wght@300;400;500;600;700&family=Outfit:wght@300;400;500;600;700&display=swap');
@import "tailwindcss";

@theme {
  --color-agro-creme: #FDFCF0;
  --color-agro-floresta: #1A3C34;
  --color-agro-ouro: #C5A059;

  --font-serif: "Fraunces", serif;
  --font-sans: "Inter", sans-serif;
  --font-outfit: "Outfit", sans-serif;
}

@layer base {
  body {
    @apply bg-agro-creme text-agro-floresta font-sans antialiased;
  }

  h1, h2, h3, h4 {
    @apply font-sans font-bold;
  }

  input,
  textarea,
  select {
    @apply text-slate-900 bg-white placeholder-slate-400 border-slate-200 focus:ring-emerald-500 focus:border-emerald-500;
  }
}

/* ==========================================================================
   PMO FORM STYLES - src/index.css (VERSÃO COMPLETA E CORRIGIDA)
   ========================================================================== */

/* ---------------------------------- */
/* A. CONFIGURAÇÕES GLOBAIS E TEMA    */
/* ---------------------------------- */
:root {
  font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;
  line-height: 1.5;
  font-weight: 400;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  font-feature-settings: "cv02", "cv03", "cv04", "cv11";

  --pmo-color-primary: #0d6efd;
  --pmo-color-secondary: #0d6efd;
  --pmo-color-success: #198754;
  --pmo-color-grey-light: #e0e0e0;
  --pmo-color-grey-text: #6c757d;

  /* Editorial Tokens */
  --editorial-paper: #FDFBF7;
  --editorial-forest: #0A2F1F;
  --editorial-soil: #4B3621;
  --editorial-clay: #A0522D;
  --editorial-accent: #D4FF00;
  --editorial-white: #FFFFFF;
}

@layer utilities {
  .bg-grain {
    position: relative;
  }
  .bg-grain::before {
    content: "";
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 50;
    opacity: 0.04;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
    mix-blend-mode: overlay;
  }

  .font-serif-editorial {
    font-family: 'Fraunces', serif;
  }
  .font-sans-editorial {
    font-family: 'DM Sans', sans-serif;
  }

  @keyframes pmoFadeInUp {
    from {
      opacity: 0;
      transform: translateY(1.5rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-pmo-reveal {
    opacity: 0;
    animation: pmoFadeInUp 1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .animate-reveal {
    opacity: 0;
    transform: translateY(2rem);
    transition: all 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Premium macOS-style scrollbar */
  .scrollbar-premium::-webkit-scrollbar {
    width: 6px;
    height: 6px;
  }
  .scrollbar-premium::-webkit-scrollbar-track {
    background: transparent;
  }
  .scrollbar-premium::-webkit-scrollbar-thumb {
    background: #475569; /* slate-600 */
    border-radius: 10px;
  }
  .scrollbar-premium::-webkit-scrollbar-thumb:hover {
    background: #334155; /* slate-700 */
  }
}

html,
body {
  width: 100%;
  overflow-x: hidden;
  margin: 0;
  padding: 0;
  background-color: #f1f5f9;
  /* slate-100 */
  color: #0f172a;
  /* slate-900 */
}

body {
  min-height: 100vh;
  position: relative;
}

.container {
  width: 100%;
  max-width: 1200px;
  margin-left: auto;
  margin-right: auto;
  padding: 1rem;
}

/* ------------------------------------------- */
/* B. ESTILOS GERAIS DO FORMULÁRIO (VISIBILIDADE) */
/* ------------------------------------------- */
.pmo-form h3 {
  font-size: 1.75rem;
  margin-bottom: 0.5rem;
}

.pmo-form h5 {
  font-size: 1.2rem;
  color: #343a40;
}

.pmo-form .form-label,
.pmo-form .form-check-label {
  font-size: 1rem;
  margin-bottom: 0.5rem;
}

.pmo-form .form-control,
.pmo-form .form-select,
.pmo-form input,
.pmo-form textarea,
.pmo-form select {
  font-size: 1rem;
  padding: 0.75rem 1rem;
  color: #0f172a !important;
  background-color: #ffffff !important;
  border: 1px solid #cbd5e1 !important;
}

.pmo-form .form-control::placeholder,
.pmo-form input::placeholder,
.pmo-form textarea::placeholder {
  color: #94a3b8 !important;
}

.pmo-form .form-group,
.pmo-form .mb-4 {
  margin-bottom: 2rem !important;
}

/* Force Dark Text for Form Labels and Headers regardless of theme */
.pmo-form label,
.pmo-form h1,
.pmo-form h2,
.pmo-form h3,
.pmo-form h4,
.pmo-form h5,
.pmo-form p,
.pmo-form span:not(.step-counter),
.step-label,
.step-sub-label {
  color: #0f172a !important;
}

.pmo-form hr {
  margin-top: 2rem;
  margin-bottom: 2rem;
}

/* ---------------------------------------- */
/* C. ESTILOS DO STEPPER (MODO CLARO)       */
/* ---------------------------------------- */

.stepper-container {
  position: relative;
  margin-bottom: 3rem;
}

.stepper-main {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.stepper-arrow {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 35px;
  height: 35px;
  border-radius: 50%;
  border: 1px solid var(--pmo-color-grey-light);
  background-color: #fff;
  color: var(--pmo-color-grey-text);
  cursor: pointer;
  transition: all 0.2s ease-in-out;
  flex-shrink: 0;
}

.stepper-arrow:hover {
  background-color: #f0f0f0;
  border-color: #adb5bd;
}

.stepper-arrow.disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.stepper-wrapper {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  flex-grow: 1;
  margin: 0 1rem;
  overflow: hidden;
}

.step-item {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
  min-width: 130px;
  padding: 0 10px;
  cursor: pointer;
  z-index: 2;
}

/* ========================================================= */
/* ||              A CORREÇÃO ESTÁ NESTE BLOCO              || */
/* ========================================================= */
.step-item:not(:first-child)::before {
  content: '';
  position: absolute;
  top: 20px;
  /* Alinhado com o centro do círculo de 40px */

  /* Puxamos a linha para começar à direita do centro do item anterior */
  right: calc(50% + 20px);
  /* 50% + metade da largura do círculo (40px/2) */

  /* A largura da linha é o espaço total MENOS a largura do círculo */
  width: calc(100% - 40px);

  height: 2px;
  background-color: var(--pmo-color-grey-light);
  z-index: 1;
  /* Garante que a linha fique atrás do círculo */
  transition: background-color 0.4s ease;
}

.step-counter {
  width: 40px;
  height: 40px;
  display: flex;
  justify-content: center;
  align-items: center;
  border-radius: 50%;
  background: #ffffff;
  border: 2px solid var(--pmo-color-grey-light);
  font-size: 1.1rem;
  font-weight: 500;
  color: var(--pmo-color-grey-text);
  transition: all 0.3s ease;
  z-index: 2;
  margin-bottom: 1rem;
}

.step-label-container {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  color: var(--pmo-color-grey-text);
}

.step-icon {
  font-size: 1.2rem;
}

.step-label {
  font-size: 0.95rem;
  font-weight: 500;
}

.step-sub-label {
  font-size: 0.8rem;
  color: var(--pmo-color-grey-text);
  margin-top: 4px;
}

.stepper-completion-counter {
  color: var(--pmo-color-grey-text);
  font-size: 0.9rem;
  margin-top: 1rem;
  text-align: center;
}

/* --- Estados do Stepper (Modo Claro) --- */
.step-item.active .step-counter {
  border-color: var(--pmo-color-primary);
  color: var(--pmo-color-primary);
}

.step-item.active .step-label-container,
.step-item.active .step-sub-label {
  color: var(--pmo-color-primary);
  font-weight: 500;
}

.step-item.em-progresso .step-counter {
  border-color: var(--pmo-color-secondary);
  color: var(--pmo-color-secondary);
  opacity: 0.7;
}

.step-item.em-progresso .step-label-container,
.step-item.em-progresso .step-sub-label {
  color: var(--pmo-color-secondary);
  opacity: 0.8;
}

.step-item.completo .step-counter {
  background-color: var(--pmo-color-success);
  border-color: var(--pmo-color-success);
  color: #ffffff;
}

.step-item.completo .step-label-container {
  color: var(--bs-body-color, #213547);
}

.step-item.completo:not(:first-child)::before,
.step-item.active.completo:not(:first-child)::before {
  background-color: var(--pmo-color-success);
}

/* ------------------------------------------- */
/* D. ESTILOS PARA O MODO ESCURO (DARK MODE)   */
/* ------------------------------------------- */
@media (prefers-color-scheme: dark) {

  :root {
    --pmo-dark-text-primary: rgba(255, 255, 255, 0.85);
    --pmo-dark-text-secondary: rgba(255, 255, 255, 0.6);
    --pmo-dark-border: rgba(255, 255, 255, 0.3);
    --pmo-dark-bg-hover: rgba(255, 255, 255, 0.08);
    --pmo-dark-active: #64b5f6;
    --pmo-dark-in-progress: #64b5f6;
    --pmo-dark-success: #81c784;
  }

  body {
    background-color: #0f172a;
    /* slate-900 */
    color: var(--pmo-dark-text-primary);
  }

  .stepper-arrow {
    background-color: transparent;
    border-color: var(--pmo-dark-border);
    color: var(--pmo-dark-text-secondary);
  }

  .stepper-arrow:hover {
    background-color: var(--pmo-dark-bg-hover);
    border-color: var(--pmo-dark-text-primary);
  }

  .step-counter {
    background-color: transparent;
    border-color: var(--pmo-dark-border);
    color: var(--pmo-dark-text-secondary);
  }

  .step-item:not(:first-child)::before {
    background-color: var(--pmo-dark-border);
  }

  .step-label-container,
  .step-sub-label,
  .stepper-completion-counter {
    color: var(--pmo-dark-text-secondary);
  }

  /* --- Estados do Stepper (Modo Escuro) --- */
  .step-item.active .step-counter {
    border-color: var(--pmo-dark-active);
    color: var(--pmo-dark-active);
  }

  .step-item.active .step-label-container,
  .step-item.active .step-sub-label {
    color: var(--pmo-dark-active);
  }

  .step-item.em-progresso .step-counter {
    border-color: var(--pmo-dark-in-progress);
    color: var(--pmo-dark-in-progress);
  }

  .step-item.em-progresso .step-label-container,
  .step-item.em-progresso .step-sub-label {
    color: var(--pmo-dark-in-progress);
  }

  .step-item.completo .step-counter {
    background-color: var(--pmo-dark-success);
    border-color: var(--pmo-dark-success);
    color: #121212;
  }

  .step-item.completo .step-label-container {
    color: var(--pmo-dark-text-primary);
  }

  .step-item.completo:not(:first-child)::before {
    background-color: var(--pmo-dark-success);
  }
}

/* ============================================= */
/* ||     ESTILOS PARA O CONECTOR DO STEPPER MUI     || */
/* ============================================= */
.MuiStepConnector-line {
  border-color: #eaeaf0;
  border-top-width: 3px;
  border-radius: 1px;
}

.MuiStep-horizontal.Mui-active .MuiStepConnector-line,
.MuiStep-horizontal.Mui-completed .MuiStepConnector-line {
  border-color: #1976D2;
}



/* ... outros estilos ... */

/* ======================================================== */
/* ||     ESTILOS PARA O STEPPER RESPONSIVO COM ROLAGEM     || */
/* ======================================================== */

.responsive-stepper-container {
  position: relative;
  width: 100%;
  display: flex;
  align-items: center;
}

.stepper-scroll-wrapper {
  overflow-x: auto;
  /* Permite a rolagem */
  scroll-behavior: smooth;
  /* Animação suave de rolagem */
  -ms-overflow-style: none;
  /* Esconde a barra de rolagem no IE e Edge */
  scrollbar-width: none;
  /* Esconde a barra de rolagem no Firefox */
}

/* Esconde a barra de rolagem no Chrome, Safari e Opera */
.stepper-scroll-wrapper::-webkit-scrollbar {
  display: none;
}

/* Estilos para impressão */
@media print {

  /* Esconde tudo que não deve ser impresso */
  .no-print {
    display: none !important;
  }

  /* Garante que apenas o conteúdo de impressão seja visível */
  body * {
    visibility: hidden;
  }

  .only-print,
  .only-print * {
    visibility: visible;
  }

  .only-print {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
  }

  /* Configurações da página A4 */
  @page {
    size: A4;
    margin: 20mm;
  }
}

/* Na tela normal, esconde o conteúdo de impressão */
@media screen {
  .only-print {
    display: none;
  }
}

/* ============================================================== */
/* ||    MAPLIBRE GL JS RESET (Enterprise Cartography)         || */
/* ============================================================== */
@import 'maplibre-gl/dist/maplibre-gl.css';
@import '@mapbox/mapbox-gl-draw/dist/mapbox-gl-draw.css';

.map-container {
  width: 100%;
  height: 100%;
}

/* Custom Marker Pills for MapLibre — Apenas label visual (sem interceptar cliques) */
.map-marker-pill {
  pointer-events: none;
  transform: translate(-50%, -50%);
  z-index: 10 !important;
}

.maplibregl-marker {
  z-index: 10 !important; /* Abaixo dos controles e drawers */
}

/* ========================================================== */
/* FIX UI/UX: MAPBOX DRAW EM AMBIENTE TAILWIND/MAPLIBRE       */
/* ========================================================== */
.maplibregl-control-container .mapboxgl-ctrl-group,
.mapboxgl-control-container .mapboxgl-ctrl-group {
  z-index: 9999 !important;
  pointer-events: auto !important;
  transform: scale(1.3);
  transform-origin: top left;
  margin-top: 16px !important;
  margin-left: 16px !important;
  border-radius: 8px;
  box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.2) !important;
  transition: transform 0.2s ease;
}

@media (max-width: 768px) {
  .maplibregl-control-container .mapboxgl-ctrl-group {
    transform: scale(1.1);
    margin-top: 12px !important;
    margin-left: 12px !important;
  }
}

/* Impede seleção de texto no mapa e overlays para não quebrar o drag */
.maplibregl-map, 
.mapboxgl-map,
.map-marker-pill,
.mapboxgl-ctrl,
.maplibregl-ctrl {
  user-select: none !important;
  -webkit-user-select: none;
  -moz-user-select: none;
  cursor: grab; /* Força o cursor de mão aberta como padrão no canvas do mapa */
}

.maplibregl-map:active,
.mapboxgl-map:active {
  cursor: grabbing !important; /* Força o cursor de mão fechada ao arrastar */
}


/* Corrige o reset do Tailwind nos botões do mapa */
.mapboxgl-ctrl-group button {
  width: 32px !important;
  height: 32px !important;
  background-color: white !important;
  cursor: pointer !important;
  pointer-events: auto !important;
}

.mapboxgl-ctrl-group button:hover {
  background-color: #f4f4f5 !important;
}

/* ========================================================== */
/* CHAT BUBBLE ANIMATION & CUSTOM SCROLLBAR UTILITIES         */
/* ========================================================== */
