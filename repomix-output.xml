						"description": "Origem do insumo (Ex: Compra comercial, Produção própria).",
					},
					"composicao": map[string]interface{}{
						"type":        "string",
						"description": "Do que é feito (Ex: NPK, Orgânico 100%).",
					},
					"marca": map[string]interface{}{
