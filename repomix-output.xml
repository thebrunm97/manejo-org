    (nome, n_total_percentual, p2o5_total_percentual, k2o_total_percentual, taxa_liberacao_n_ciclo1, taxa_liberacao_p_ciclo1, taxa_liberacao_k_ciclo1)
VALUES
    ('Esterco Bovino Curtido', 1.5, 1.0, 2.0, 0.3, 0.6, 1.0),
