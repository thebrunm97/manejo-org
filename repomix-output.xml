// LoadConfig loads the settings from the .env file
func LoadConfig() *Config {
	err := godotenv.Load()
	if err != nil {
		log.Println("Warning: .env file not found, using system environment variables.")
	}

	return &Config{
		EvoBaseURL:          os.Getenv("EVOLUTION_BASE_URL"),
