                        </button>
                    </div>
                    <pre className="whitespace-pre-wrap break-all max-h-[450px] overflow-y-auto scrollbar-premium pr-6 custom-json-scrollbar">
                        {JSON.stringify(job.raw_payload || {}, null, 2)}
