# Fase 3 — proxy reverso com TLS automático (Let's Encrypt) via Caddy.
#
# Substitui o túnel ngrok que antes encaminhava para 127.0.0.1:8080. O
# Caddy assume esse papel na VPS: recebe HTTPS na porta 443/80 publicamente
# e encaminha internamente para pmo-bot-go:8080 (que continua só em
# 127.0.0.1:8080 na rede docker interna — não expor o Go direto).
#
# SITE_DOMAIN = bot.fyto.io (webhook/API do pmo-bot-go). O domínio
# manejo.org citado nas versões anteriores deste comentário nunca existiu de
# fato -- era um placeholder que ficou. fyto.io é o domínio real, já
# registrado na Hostinger, então SITE_DOMAIN e FRONTEND_DOMAIN vivem como
# subdomínios dele (bot.fyto.io e manejo.fyto.io).
#
# SITE_DOMAIN, FRONTEND_DOMAIN e ACME_EMAIL vêm do .env.prod (injetados no
# serviço caddy via env_file no docker-compose.prod.yml).

{$SITE_DOMAIN} {
	# Encaminha tudo pro pmo-bot-go. Se no futuro for preciso expor o
	# evolution-go/manager também, adicionar um bloco de path específico
	# (ex.: handle_path /evolution/* -> evolution-go:8082) em vez de abrir
	# a raiz do domínio pra ele.
	reverse_proxy pmo-bot-go:8080

	# Let's Encrypt precisa de um e-mail de contato pra avisos de expiração.
	tls {$ACME_EMAIL}

	log {
		output file /data/access.log {
			roll_size 10mb
			roll_keep 5
		}
	}
}

# Frontend (SPA React/Vite) migrando da Vercel pra cá. Serve o build
# estático já pronto dentro do container pmo-frontend (ver
# pmo-frontend/Dockerfile e pmo-frontend/Caddyfile para o fallback de SPA
# routing e os headers de cache do service worker).
{$FRONTEND_DOMAIN} {
	reverse_proxy pmo-frontend:80

	tls {$ACME_EMAIL}

	log {
		output file /data/access-frontend.log {
			roll_size 10mb
			roll_keep 5
		}
	}
}

# ai-memory (memória de longo prazo cross-agent/cross-máquina). Sem porta
# publicada no host (ver deploy/docker-compose.ai-memory.yml) -- só alcançável
# via este domínio, com Bearer token obrigatório checado pelo próprio
# ai-memory (AI_MEMORY_AUTH_TOKEN). MEMORIA_DOMAIN vem do .env.prod, mesmo
# padrão de SITE_DOMAIN/FRONTEND_DOMAIN acima.
{$MEMORIA_DOMAIN} {
	reverse_proxy ai-memory:49374

	tls {$ACME_EMAIL}

	log {
		output file /data/access-memoria.log {
			roll_size 10mb
			roll_keep 5
		}
	}
}
