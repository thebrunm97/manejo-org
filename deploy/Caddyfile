# Fase 3 — proxy reverso com TLS automático (Let's Encrypt) via Caddy.
#
# Substitui o túnel ngrok que hoje encaminha para 127.0.0.1:8080. O Caddy
# assume esse papel na VPS: recebe HTTPS na porta 443/80 publicamente e
# encaminha internamente para pmo-bot-go:8080 (que continua só em
# 127.0.0.1:8080 na rede docker interna — não expor o Go direto).
#
# TODO (Bruno): confirmar o domínio definitivo antes de subir. O DNS já foi
# apontado pro IP da VPS (Fase 3, item 1) — falta só saber qual subdomínio
# usar aqui (ex.: bot.manejo.org, webhook.manejo.org, api.manejo.org...).
# app.manejo.org e admin.manejo.org já existem e apontam pro frontend
# (Vercel) — não usar esses dois aqui.
#
# SITE_DOMAIN e ACME_EMAIL vêm do .env.prod (adicionados abaixo no
# docker-compose.prod.yml via variável de ambiente do serviço caddy).

{$SITE_DOMAIN} {
	# Encaminha tudo pro pmo-bot-go. Se no futuro for preciso expor o
	# evolution-go/manager também, adicionar um bloco de path específico
	# (ex.: handle_path /evolution/* -> evolution-go:8082) em vez de abrir
	# a raiz do domínio pra ele.
	reverse_proxy pmo-bot-go:8080

	# Let's Encrypt precisa de um e-mail de contato pra avisos de expiração.
	tls {$ACME_EMAIL}

	log {
		output file /data/access.log {
			roll_size 10mb
			roll_keep 5
		}
	}
}
