# --- PMO-Bot-Go ---
# Copy this file to .env and fill in the values.

# WPPConnect webhook authentication token
WPPCONNECT_TOKEN=your_wppconnect_# Pmo Bot Go Backend - Configuração

# WPPConnect Server Credentials
WPPCONNECT_URL="http://127.0.0.1:21465"
WPPCONNECT_TOKEN="TY6oMv4d20a3"
WPP_SESSION="thebrum97" # A sessão que será usada para enviar as mensagens
PUPPETEER_ARGS="--no-sandbox --disable-setuid-sandbox"

# Groq API (LLM Extração)
GROQ_API_KEY="sua_chave_groq_aqui"

# Gemini API (LLM Especialista)
GEMINI_API_KEY="sua_chave_gemini_aqui"

# Supabase Credentials (DB)
SUPABASE_URL="https://seu-projeto.supabase.co"
SUPABASE_KEY="sua-service-role-key-aqui"

# Servidor Web
PORT="8080"
GIN_MODE="release" (default: release)
# GIN_MODE=release

# --- Evolution API ---
EVOLUTION_BASE_URL="http://localhost:8082"
EVOLUTION_INSTANCE_NAME="teste-instancia"
EVOLUTION_API_KEY="123456"

# Flagsmith Feature Flags
FLAGSMITH_ENV_KEY="sua-chave-aqui"
FLAGSMITH_BASE_URL="http://localhost:8000/api/v1/"
