# --- PMO-Bot-Go ---
# Copy this file to .env and fill in the values.

# Groq API (LLM Extração)
GROQ_API_KEY="sua_chave_groq_aqui"

# Gemini API (LLM Especialista)
GEMINI_API_KEY="sua_chave_gemini_aqui"

# Supabase Credentials (DB)
SUPABASE_URL="https://seu-projeto.supabase.co"
SUPABASE_KEY="sua-service-role-key-aqui"

# Servidor Web
PORT="8080"
GIN_MODE="release" (default: release)
# GIN_MODE=release

# --- Evolution API ---
EVOLUTION_BASE_URL="http://localhost:8082"
EVOLUTION_INSTANCE_NAME="teste-instancia"
EVOLUTION_API_KEY="123456"

# URL que a Evolution chama para entregar mensagens (SEM ?token= — a
# autenticação vai pelo header Authorization: Bearer, configurado via
# WEBHOOK_TOKEN abaixo e compartilhado com o serviço evolution-go pelo mesmo
# .env). Colocar o token na URL expõe o segredo em log de proxy, histórico e
# no próprio registro do webhook salvo em texto plano no banco da Evolution.
WEBHOOK_URL="http://localhost:8080/webhook/evolution"
WEBHOOK_TOKEN="gere-um-valor-aleatorio-forte-aqui"

# Flagsmith Feature Flags
FLAGSMITH_ENV_KEY="sua-chave-aqui"
FLAGSMITH_BASE_URL="http://localhost:8000/api/v1/"

# Clima / Previsão do Tempo
WEATHER_API_KEY="sua_chave_weatherapi_aqui"

# Google Earth Engine
# Caminho do JSON da service account. Em produção o docker-compose monta
# ./pmo-bot-go/.secrets como /.secrets:ro, então o caminho abaixo é o do
# CONTÊINER, não o do host.
#
# O arquivo é gitignored e não vem no git pull: copie-o para a VPS à parte.
# Se ele faltar, o bot sobe normalmente — NewGEEAuth só loga um aviso — mas as
# rotas de mapa não chegam a ser registradas e respondem 404 sem erro fatal.
GEE_CREDENTIALS_PATH="/.secrets/gee-sa.json"

# Memory Cache (Application-Level Caching)
MEMORY_CACHE_ENABLED="true"
MEMORY_CACHE_TTL_REDIS_H=4
MEMORY_CACHE_TTL_SUPABASE_WARM_D=7
MEMORY_CACHE_TTL_SUPABASE_COOL_D=3
MEMORY_IMPORTANCE_THRESHOLD=0.4
MEMORY_SUPABASE_THRESHOLD=0.7
MEMORY_REDIS_MAX_FRAGMENTS=20
